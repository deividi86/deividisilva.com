---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} · Deividi Silva`} description={post.data.description} type="article">
  <article class="post">
    <header>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.draft && <span class="draft">draft</span>}
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <ul class="tags">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
